{
  "name": "quantum-safe-proxy-energy",
  "version": "1.0.0",
  "description": "Demo: Quantum Safe Proxy exposes legacy Energy OT systems over post-quantum TLS without changing them",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "sh -c '[ -f .env ] || cp .env.example .env' && bash scripts/gen-certs.sh",
    "legacy": "node src/legacy/ot-simulator.js",
    "proxy": "node src/proxy/server.js",
    "demo": "npm run setup --silent && node src/start-all.js",
    "cli": "node src/cli/qsp.js",
    "reset": "rm -rf data/state.json evidence logs",
    "demo:reset": "npm run reset",
    "stop": "pkill -f 'src/(start-all|legacy/ot-simulator|proxy/server).js' || true",
    "test": "node --test tests/"
  }
}
