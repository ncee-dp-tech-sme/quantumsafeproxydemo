# Quantum Safe Proxy (QSP) demo configuration - copy to .env (npm run setup does this)
# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Admin API + dashboard (always keep on loopback)
QSP_BIND_HOST=127.0.0.1
QSP_ADMIN_PORT=8080

# TLS policy: only hybrid post-quantum key exchange groups are accepted (ML-KEM)
QSP_ALLOWED_GROUPS=X25519MLKEM768:SecP256r1MLKEM768:SecP384r1MLKEM1024
# Mutual TLS: only clients holding a certificate from the local CA may reach OT assets
QSP_REQUIRE_CLIENT_CERT=true
QSP_CERT_DIR=./certs

# Legacy OT simulator (mock devices, plaintext Modbus/TCP)
LEGACY_BIND_HOST=127.0.0.1

# Timeouts (ms)
QSP_UPSTREAM_TIMEOUT_MS=5000
QSP_IDLE_TIMEOUT_MS=60000

# OpenSSL >= 3.5 is required for ML-KEM (used by the independent verifier)
OPENSSL_BIN=openssl
